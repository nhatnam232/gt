generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Category {
  ACOUSTIC
  ELECTRIC
  BASS
  CLASSICAL
  UKULELE
  AMPLIFIER
  PEDAL
  ACCESSORY
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  DISCONTINUED
  PREORDER
}

enum Handedness {
  RIGHT
  LEFT
  AMBIDEXTROUS
}

enum PriceTier {
  BUDGET
  MID
  PRO
  BOUTIQUE
}

enum SourceKind {
  OFFICIAL_BRAND
  RETAILER
  AGGREGATOR
  EXPERT_REVIEW
  USER_COMMUNITY
  WIKIDATA
}

enum CrawlStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

// ---------------------------------------------------------------------------
// Users & Auth (Better Auth manages sessions/accounts)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          UserRole @default(USER)
  banned        Boolean  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions    Session[]
  accounts    Account[]
  reviews     UserReview[]
  comparisons SavedComparison[]
  discussions Discussion[]
  votes       ReviewVote[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Brands
// ---------------------------------------------------------------------------

model Brand {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  countryCode  String?
  foundedYear  Int?
  logoUrl      String?
  websiteUrl   String?
  description  String?
  priceTier    PriceTier?
  isFeatured   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guitars Guitar[]

  @@map("brands")
}

// ---------------------------------------------------------------------------
// Instruments
// ---------------------------------------------------------------------------

model Guitar {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  brandId        String
  series         String?
  model          String?
  year           Int?
  category       Category
  subtype        String?
  bodyShape      String?
  cutaway        Boolean      @default(false)
  electroAcoustic Boolean    @default(false)
  topWood        String?
  backWood       String?
  sideWood       String?
  neckWood       String?
  fingerboard    String?
  frets          Int?
  strings        Int?
  scaleLengthIn  Decimal?     @db.Decimal(5, 3)
  nutWidthIn     Decimal?     @db.Decimal(5, 3)
  nutMaterial    String?
  bridge         String?
  pickupConfig   String?
  electronics    String?
  finish         String?
  color          String?
  madeIn         String?
  weightKg       Decimal?     @db.Decimal(5, 3)
  handedness     Handedness   @default(RIGHT)
  caseIncluded   Boolean      @default(false)
  warranty       String?
  msrp           Decimal?     @db.Decimal(10, 2)
  availability   Availability @default(IN_STOCK)
  expertScore    Decimal?     @db.Decimal(4, 2)
  userScore      Decimal?     @db.Decimal(4, 2)
  valueScore     Decimal?     @db.Decimal(4, 2)
  popularityRank Int?
  isPublished    Boolean      @default(false)
  summary        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  brand       Brand             @relation(fields: [brandId], references: [id])
  images      GuitarImage[]
  prices      PricePoint[]
  reviews     UserReview[]
  discussions Discussion[]
  rankEntries RankingEntry[]
  externalIds ExternalId[]
  sources     GuitarSource[]
  comparisonsA SavedComparison[] @relation("CompareGuitarA")
  comparisonsB SavedComparison[] @relation("CompareGuitarB")

  @@index([brandId])
  @@index([category])
  @@index([isPublished])
  @@index([slug])
  @@map("guitars")
}

model GuitarImage {
  id        String   @id @default(cuid())
  guitarId  String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  guitar Guitar @relation(fields: [guitarId], references: [id], onDelete: Cascade)

  @@index([guitarId])
  @@map("guitar_images")
}

model ExternalId {
  id       String @id @default(cuid())
  guitarId String
  source   String
  extId    String
  url      String?

  guitar Guitar @relation(fields: [guitarId], references: [id], onDelete: Cascade)

  @@unique([guitarId, source])
  @@map("external_ids")
}

model GuitarSource {
  id       String @id @default(cuid())
  guitarId String
  sourceId String
  url      String?

  guitar Guitar @relation(fields: [guitarId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id])

  @@unique([guitarId, sourceId])
  @@map("guitar_sources")
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------

model Source {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  kind         SourceKind
  baseUrl      String
  trustWeight  Decimal    @default(1) @db.Decimal(4, 3)
  rateLimitMs  Int        @default(1000)
  enabled      Boolean    @default(true)
  lastCrawled  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  prices  PricePoint[]
  guitars GuitarSource[]
  jobs    CrawlJob[]

  @@map("sources")
}

model PricePoint {
  id          String   @id @default(cuid())
  guitarId    String
  sourceId    String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  url         String?
  inStock     Boolean  @default(true)
  recordedAt  DateTime @default(now())

  guitar Guitar @relation(fields: [guitarId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id])

  @@index([guitarId])
  @@index([recordedAt])
  @@map("price_points")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model UserReview {
  id         String   @id @default(cuid())
  guitarId   String
  userId     String
  rating     Decimal  @db.Decimal(3, 1)
  title      String?
  body       String?
  pros       String?
  cons       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guitar Guitar      @relation(fields: [guitarId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes  ReviewVote[]

  @@unique([guitarId, userId])
  @@index([guitarId])
  @@map("user_reviews")
}

model ReviewVote {
  id       String   @id @default(cuid())
  reviewId String
  userId   String
  helpful  Boolean
  createdAt DateTime @default(now())

  review UserReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

// ---------------------------------------------------------------------------
// Rankings
// ---------------------------------------------------------------------------

model Ranking {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RankingEntry[]

  @@map("rankings")
}

model RankingEntry {
  id        String   @id @default(cuid())
  rankingId String
  guitarId  String
  position  Int
  score     Decimal  @db.Decimal(5, 3)
  createdAt DateTime @default(now())

  ranking Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  guitar  Guitar  @relation(fields: [guitarId], references: [id], onDelete: Cascade)

  @@unique([rankingId, guitarId])
  @@unique([rankingId, position])
  @@index([rankingId])
  @@map("ranking_entries")
}

// ---------------------------------------------------------------------------
// Discussions & Comments
// ---------------------------------------------------------------------------

model Discussion {
  id        String    @id @default(cuid())
  guitarId  String
  userId    String
  title     String?
  body      String
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guitar   Guitar    @relation(fields: [guitarId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]

  @@index([guitarId])
  @@map("discussions")
}

model Comment {
  id           String    @id @default(cuid())
  discussionId String
  parentId     String?
  authorName   String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent     Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]  @relation("CommentReplies")

  @@index([discussionId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Compare & Wishlist
// ---------------------------------------------------------------------------

model SavedComparison {
  id         String   @id @default(cuid())
  userId     String
  guitarAId  String
  guitarBId  String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guitarA Guitar  @relation("CompareGuitarA", fields: [guitarAId], references: [id])
  guitarB Guitar? @relation("CompareGuitarB", fields: [guitarBId], references: [id])

  @@map("saved_comparisons")
}

// ---------------------------------------------------------------------------
// Articles (Guides / Reviews / News / Deals)
// ---------------------------------------------------------------------------

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  type        String   // guide | review | news | deal
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  coverAlt    String?
  authorName  String
  readMinutes Int      @default(5)
  tags        String[] @default([])
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isPublished])
  @@index([slug])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// ETL Crawl Jobs
// ---------------------------------------------------------------------------

model CrawlJob {
  id           String      @id @default(cuid())
  target       String
  status       CrawlStatus @default(QUEUED)
  sourceId     String?
  itemsFound   Int         @default(0)
  itemsNew     Int         @default(0)
  itemsUpdated Int         @default(0)
  itemsFailed  Int         @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime    @default(now())

  source Source? @relation(fields: [sourceId], references: [id])

  @@index([status])
  @@map("crawl_jobs")
}
