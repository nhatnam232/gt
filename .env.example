# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=GuitarTribe

# ---------------------------------------------------------------------------
# PostgreSQL (Prisma). Use the pooled URL for the app, direct for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://guitar:guitar@localhost:5432/guitartribe?schema=public
DIRECT_URL=postgresql://guitar:guitar@localhost:5432/guitartribe?schema=public

# ---------------------------------------------------------------------------
# Redis cache. Works with Upstash REST (production) or local Redis via proxy.
# Leave empty to fall back to an in-process LRU cache (dev only).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=gt:v1

# ---------------------------------------------------------------------------
# Meilisearch
# ---------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKeyChangeMe
MEILISEARCH_ADMIN_KEY=masterKeyChangeMe
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
MEILISEARCH_INDEX=guitars

# ---------------------------------------------------------------------------
# Cloudinary (image storage + CDN)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=guitartribe
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated emails that are promoted to ADMIN on first sign-in.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# ETL / crawler
# ---------------------------------------------------------------------------
CRAWLER_USER_AGENT=GuitarTribeBot/1.0 (+https://example.com/bot)
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY_MS=1200
CRAWLER_RESPECT_ROBOTS=true
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW=60 s
RATE_LIMIT_MAX=120
