# =============================================
# GuitarTribe environment variables
# Copy to .env.local for local development.
# All defaults work with docker-compose.yml.
# =============================================

# -- Database -------------------------------------------
DATABASE_URL="postgresql://guitar:guitar@localhost:5432/guitartribe"
DIRECT_URL="postgresql://guitar:guitar@localhost:5432/guitartribe"

# -- Redis (Upstash) ------------------------------------
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_token"

# -- Meilisearch ----------------------------------------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="masterKeyChangeMe"

# -- Cloudinary -----------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -- Auth (Better Auth) ---------------------------------
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional for local dev)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -- Admin ----------------------------------------------
# Comma-separated list of email addresses that get the ADMIN role on first sign-in
ADMIN_EMAILS=""

# -- Cron -----------------------------------------------
# Shared secret checked by /api/cron/* routes and Vercel cron jobs
CRON_SECRET="change-me-to-a-random-secret"

# -- App ------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -- Crawler (optional) ---------------------------------
CRAWLER_USER_AGENT="GuitarTribeBot/1.0 (https://guitartribe.io; bot@guitartribe.io)"
CRAWLER_CONCURRENCY="2"
CRAWLER_DELAY_MS="1500"
CRAWLER_RESPECT_ROBOTS="true"
