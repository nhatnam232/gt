# ---------------------------------------------------------------------------
# GuitarTribe environment variables
# Copy to .env.local for local dev. On Netlify: Site configuration > Environment variables
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ---------------------------------------------------
# Neon: https://console.neon.tech  -> Project > Connection string
# Supabase: Project Settings > Database > Connection string
# Local docker compose default is below.
DATABASE_URL="postgresql://guitar:guitar@localhost:5432/guitartribe"
# Direct (non-pooled) URL used by `prisma migrate`. On Neon this is the
# connection string WITHOUT `-pooler` in the hostname.
DIRECT_URL="postgresql://guitar:guitar@localhost:5432/guitartribe"

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="GuitarTribe"

# --- Redis cache (optional; falls back to no cache) ------------------------
# Upstash: https://console.upstash.com -> Create database -> REST API tab
# Local docker compose provides a compatible HTTP facade on :8079
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_token"
CACHE_PREFIX="gt:v1"

# --- Meilisearch (optional; falls back to Postgres search) -----------------
# Meilisearch Cloud: https://cloud.meilisearch.com -> Project -> Settings
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="masterKeyChangeMe"
MEILISEARCH_ADMIN_KEY=""
MEILISEARCH_INDEX="guitars"

# --- Cloudinary (optional; image uploads) ----------------------------------
# https://console.cloudinary.com -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="guitartribe"

# --- Auth (REQUIRED) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-now"
# Must match your deployed origin exactly (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:    https://your-site.netlify.app
#   Callback URL:    https://your-site.netlify.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://your-site.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that get the ADMIN role on first sign-up
ADMIN_EMAILS="you@example.com"

# --- Crawler / cron --------------------------------------------------------
CRAWLER_USER_AGENT="GuitarTribeBot/1.0"
CRAWLER_CONCURRENCY="4"
CRAWLER_DELAY_MS="1200"
CRAWLER_RESPECT_ROBOTS="true"
# Any long random string. Shared between Netlify scheduled functions and /api/cron/*
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW="60 s"
RATE_LIMIT_MAX="120"
