# better-auth declares optional peer deps for every framework it supports
# (@sveltejs/kit, solid-js, etc.). @sveltejs/kit transitively demands vite@8,
# while @vitejs/plugin-react (used by vitest) supports up to vite@7.
# These peers are never actually installed or used by this Next.js app, so we
# tell npm to use the pre-v7 (non-strict) peer resolution algorithm.
legacy-peer-deps=true

# Keep installs quiet and deterministic in CI
fund=false
audit=false
